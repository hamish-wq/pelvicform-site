---
import Layout from '../layouts/Layout.astro';
import Wave from '../components/Wave.astro';
import ContactForm from '../components/ContactForm.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { SITE } from '../lib/site';
import { PF_SERVICES } from '../lib/services-data';

export function getStaticPaths() {
  return Object.values(PF_SERVICES).map((s) => ({ params: { slug: s.slug } }));
}
const { slug } = Astro.params;
const s = PF_SERVICES[slug as string];
const canonical = `${SITE.domain}/${s.slug}`;

const schemaJson = [
  { '@context': 'https://schema.org', '@type': 'MedicalSpecialty', name: s.label, relevantSpecialty: 'Physiotherapy' },
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.domain },
    { '@type': 'ListItem', position: 2, name: s.label, item: canonical },
  ]},
];
---
<Layout title={s.metaTitle} description={s.metaDescription} canonical={canonical} keywords={s.keywords} schemaJson={schemaJson}>
  <section class="relative overflow-hidden bg-pf-navy">
    <div class="absolute inset-0">
      <img src={s.heroImage} alt={`${s.label} at PelvicForm Ponsonby`} class="w-full h-full object-cover opacity-30" style="object-position:center;" />
      <div class="absolute inset-0 bg-gradient-to-r from-pf-navy from-30% via-pf-navy/90 to-pf-navy/50"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-4 py-20 md:py-28">
      <div class="max-w-2xl">
        <p class="text-pf-orange text-sm font-extrabold uppercase tracking-widest mb-4">{s.eyebrow} · Ponsonby</p>
        <h1 class="text-4xl md:text-5xl font-extrabold text-white leading-tight mb-5">{s.h1}</h1>
        <p class="text-lg text-blue-100 mb-8 leading-relaxed">{s.intro}</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href={SITE.bookUrl} class="btn-accent">Book your assessment</a>
          <a href="tel:+6498864611" class="btn-ghost">Or call 09 886 4611</a>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#004A80" to="#FFFFFF" />

  <section class="bg-white py-8 border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-4 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div><p class="text-3xl font-extrabold text-pf-orange">Discreet</p><p class="text-sm text-pf-slate mt-1">Private, on your terms</p></div>
      <div><p class="text-3xl font-extrabold text-pf-orange">ACC</p><p class="text-sm text-pf-slate mt-1">Incl. birth injuries</p></div>
      <div><p class="text-3xl font-extrabold text-pf-orange">No</p><p class="text-sm text-pf-slate mt-1">Referral needed</p></div>
      <div><p class="text-3xl font-extrabold text-pf-orange">Ponsonby</p><p class="text-sm text-pf-slate mt-1">All of Auckland</p></div>
    </div>
  </section>

  <!-- BODY: the depth -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 space-y-10">
      {s.body.map((b) => (
        <div>
          <h2 class="text-2xl md:text-3xl mb-3">{b.heading}</h2>
          <p class="text-lg text-pf-slate leading-relaxed">{b.text}</p>
        </div>
      ))}
    </div>
  </section>

  <Wave from="#FFFFFF" to="#FFF6E8" />

  <section class="bg-pf-orange-light py-16 md:py-20">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <p class="text-pf-orange text-sm font-extrabold uppercase tracking-widest mb-2">{s.conditionsHeading}</p>
        <h2 class="text-3xl md:text-4xl">Expert, tailored care</h2>
      </div>
      <div class="grid md:grid-cols-2 gap-5">
        {s.conditions.map((c) => (
          <div class="bg-white rounded-2xl p-6 border border-orange-100 hover:border-pf-orange hover:shadow-md transition-all">
            <h3 class="text-lg mb-2 leading-snug">{c.name}</h3>
            <p class="text-sm text-pf-slate leading-relaxed">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {s.pricing && (
    <section class="bg-pf-orange-light pb-16 md:pb-20">
      <div class="max-w-3xl mx-auto px-4">
        <div class="bg-white rounded-3xl p-8 md:p-10 border border-orange-100">
          <h2 class="text-2xl md:text-3xl mb-2">{s.pricing.heading}</h2>
          <p class="text-pf-slate leading-relaxed mb-6">{s.pricing.intro}</p>
          <ul class="space-y-4">
            {s.pricing.rows.map((r) => (
              <li class="flex justify-between gap-4 border-b border-orange-100 pb-3 last:border-0"><span class="text-pf-slate">{r.item}</span><span class="font-extrabold text-pf-navy shrink-0">{r.price}</span></li>
            ))}
          </ul>
          {s.pricing.note && <p class="text-sm text-slate-500 mt-5">{s.pricing.note}</p>}
        </div>
      </div>
    </section>
  )}

  <Wave from="#FFF6E8" to="#FFFFFF" />

  <ContactForm sourcePage={s.slug} />
  <FinalCTA />
</Layout>
