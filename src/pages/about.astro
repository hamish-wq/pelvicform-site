---
import Layout from '../layouts/Layout.astro';
import Wave from '../components/Wave.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { SITE } from '../lib/site';
const title = 'About PelvicForm | Pelvic Floor Physio Clinic, Ponsonby';
const description = 'PelvicForm is a dedicated pelvic floor physiotherapy clinic in Ponsonby, Auckland, for men and women. Discreet, expert, multidisciplinary care. Part of Return To Form.';
const canonical = `${SITE.domain}/about`;
---
<Layout title={title} description={description} canonical={canonical}>
  <section class="bg-pf-navy py-16 md:py-20 text-center">
    <div class="max-w-3xl mx-auto px-4">
      <p class="text-pf-orange text-sm font-extrabold uppercase tracking-widest mb-4">About</p>
      <h1 class="text-4xl md:text-5xl font-extrabold text-white mb-5">A clinic devoted to pelvic health</h1>
      <p class="text-lg text-blue-100">For men and women, in Ponsonby. Part of Return To Form.</p>
    </div>
  </section>
  <Wave from="#004A80" to="#FFFFFF" />
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 space-y-6 text-pf-slate leading-relaxed">
      <p class="text-xl text-pf-ink font-semibold">Pelvic health is one of the most common things people struggle with, and one of the least talked about.</p>
      <p>PelvicForm is a dedicated pelvic floor physiotherapy clinic. This is what we do, with the privacy, time and expertise it deserves. We attract patients from all over Auckland who are looking for a highly private, tailored approach to get their bodies working with them, not against them.</p>
      <p>We treat men and women. We help with incontinence, prolapse, endometriosis, pregnancy and postpartum recovery, prostate-surgery recovery, bladder control and pelvic pain. Much of it is ACC-covered, including maternal birth injuries, which we lodge for you, and you never need a referral to start.</p>
      <p>Our approach is multidisciplinary: targeted physiotherapy with real-time ultrasound, Clinical Pilates in our onsite studio, the PelviPower chair, and onsite acupuncture and shockwave for chronic pain. We build the right combination around your assessment.</p>
      <p>PelvicForm is part of <a href={SITE.rtfUrl} class="text-pf-orange font-semibold underline">Return To Form</a>, our physiotherapy clinic in Ponsonby. For anything beyond pelvic health, the wider team is right there.</p>
    </div>
  </section>
  <FinalCTA />
</Layout>
