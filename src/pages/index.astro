---
import Layout from '../layouts/Layout.astro';
import Wave from '../components/Wave.astro';
import ContactForm from '../components/ContactForm.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { SITE } from '../lib/site';
import { PF_SERVICES, IMAGES } from '../lib/services-data';

const title = 'Pelvic Floor Physio Auckland | PelvicForm Ponsonby';
const description = 'Specialist pelvic floor physiotherapy in Ponsonby, Auckland, for men and women. Discreet care for incontinence, prostate recovery, pelvic pain, plus Clinical Pilates and PelviPower. No referral needed. Book your assessment.';
const canonical = `${SITE.domain}/`;
const keywords = 'pelvic floor physio auckland, pelvic health ponsonby, incontinence treatment, prolapse physio, prostate recovery, pelvipower, clinical pilates, mens pelvic health, womens pelvic health';

const modalities = [
  { name: 'Targeted Physiotherapy', desc: 'Using real-time ultrasound to make sure you are activating the right muscles.', img: IMAGES.ultrasound },
  { name: 'Clinical Pilates', desc: 'Rebuilding your core safely in our onsite studio.', img: IMAGES.pilates, href: '/clinical-pilates' },
  { name: 'The PelviPower Chair', desc: 'Non-invasive magnetic stimulation to rapidly build muscle coordination while you sit, fully clothed.', img: IMAGES.pelvipower, href: '/pelvipower-therapy' },
  { name: 'Acupuncture & Shockwave', desc: 'Our onsite acupuncturist and physios use advanced therapies to release chronic pelvic pain and overactive muscles.', img: IMAGES.acupuncture },
];

const faqs = [
  { q: 'Do I need a referral?', a: 'No. You can book directly. If a specialist referral would help, we can arrange one.' },
  { q: 'Is this only for women?', a: 'No. We treat men and women. Men come to us for prostate recovery, bladder control and pelvic pain; women for incontinence, prolapse, endometriosis, pregnancy and postpartum recovery.' },
  { q: 'Is it covered by ACC?', a: 'Often, including maternal birth injuries. We lodge ACC birth injury claims for you. Give us a call and we will tell you what is funded.' },
  { q: 'What happens at the first visit?', a: 'A comprehensive 1-hour assessment: we check your skeletal alignment, use real-time ultrasound, and (only with your consent) an internal exam to see exactly how your muscles activate. You leave with a clear plan and a take-home guide.' },
];
const schemaJson = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Layout title={title} description={description} canonical={canonical} keywords={keywords} schemaJson={schemaJson}>
  <!-- HERO -->
  <section class="relative overflow-hidden bg-pf-navy">
    <div class="absolute inset-0">
      <img src={IMAGES.consult2} alt="Pelvic floor physiotherapist consulting with a patient in Ponsonby" class="w-full h-full object-cover opacity-30" />
      <div class="absolute inset-0 bg-gradient-to-r from-pf-navy from-25% via-pf-navy/90 to-pf-navy/40"></div>
    </div>
    <div class="relative max-w-6xl mx-auto px-4 py-24 md:py-32">
      <div class="max-w-2xl">
        <p class="text-pf-orange text-sm font-extrabold uppercase tracking-widest mb-4">Pelvic floor physio · Ponsonby, Auckland</p>
        <h1 class="text-4xl md:text-6xl font-extrabold text-white leading-[1.05] mb-6">Regain your everyday freedom</h1>
        <p class="text-xl text-blue-100 mb-8 leading-relaxed">Auckland's expert pelvic floor physio clinic. Discreet care, pain relief, Clinical Pilates and PelviPower treatments in Ponsonby, for men and women.</p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/womens-pelvic-health" class="btn-accent">Women's Pelvic Health</a>
          <a href="/mens-pelvic-health" class="btn-ghost">Men's Pelvic Health</a>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#004A80" to="#FFFFFF" />

  <!-- EMPATHY / POSITIONING (real copy) -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <p class="text-xl text-pf-ink font-semibold leading-relaxed mb-5">Pelvic health shouldn't dictate your life.</p>
      <p class="text-lg text-pf-slate leading-relaxed mb-4">As expert pelvic physiotherapists, we see the impact it has every day. You might find yourself mapping out the toilets before leaving the house, avoiding exercise because of leaks, or dealing with pain that affects your intimate life.</p>
      <p class="text-lg text-pf-slate leading-relaxed">Whether you are recovering from prostate surgery, managing postpartum changes (including ACC-covered birth injuries), or going through menopause, you don't have to just put up with it. We help you get your body working with you, not against you.</p>
    </div>
  </section>

  <Wave from="#FFFFFF" to="#004A80" />

  <!-- THE TWO PATHWAYS -->
  <section class="bg-pf-navy py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12"><p class="text-pf-orange text-sm font-extrabold uppercase tracking-widest mb-2">The pathways</p><h2 class="text-3xl md:text-4xl text-white">Where would you like to start?</h2></div>
      <div class="grid md:grid-cols-2 gap-6">
        <a href="/womens-pelvic-health" class="group bg-white rounded-3xl overflow-hidden hover:ring-2 hover:ring-pf-orange transition-all">
          <div class="aspect-[16/9] overflow-hidden"><img src={IMAGES.womens} alt="Women's pelvic health physiotherapy" class="w-full h-full object-cover group-hover:scale-105 transition-transform" /></div>
          <div class="p-7"><h3 class="text-2xl mb-2 group-hover:text-pf-orange transition-colors">Women's Pelvic Health</h3><p class="text-pf-slate leading-relaxed mb-4">Expert physio for incontinence, prolapse, endometriosis, and safe guidance through pregnancy and postpartum recovery. We lodge ACC maternal birth injury claims.</p><span class="text-pf-orange font-extrabold">Explore women's services →</span></div>
        </a>
        <a href="/mens-pelvic-health" class="group bg-white rounded-3xl overflow-hidden hover:ring-2 hover:ring-pf-orange transition-all">
          <div class="aspect-[16/9] overflow-hidden"><img src={IMAGES.mens} alt="Men's pelvic health physiotherapy" class="w-full h-full object-cover group-hover:scale-105 transition-transform" /></div>
          <div class="p-7"><h3 class="text-2xl mb-2 group-hover:text-pf-orange transition-colors">Men's Pelvic Health</h3><p class="text-pf-slate leading-relaxed mb-4">Practical, structured pre- and post-operation treatment focused on bladder control, pelvic pain and erectile function before and after prostate treatment.</p><span class="text-pf-orange font-extrabold">Explore men's services →</span></div>
        </a>
      </div>
    </div>
  </section>

  <Wave from="#004A80" to="#FFFFFF" />

  <!-- MULTIDISCIPLINARY -->
  <section class="bg-white py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12 max-w-2xl mx-auto"><p class="text-pf-orange text-sm font-extrabold uppercase tracking-widest mb-2">Our approach</p><h2 class="text-3xl md:text-4xl mb-3">No one-size-fits-all</h2><p class="text-lg text-pf-slate">Depending on your assessment, your rehabilitation might draw on any of these, working together.</p></div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
        {modalities.map((m) => (
          <div class="bg-pf-orange-light rounded-2xl overflow-hidden border border-orange-100">
            <div class="aspect-[4/3] overflow-hidden bg-white"><img src={m.img} alt={m.name} class="w-full h-full object-cover" /></div>
            <div class="p-5">
              <h3 class="text-base mb-2 leading-snug">{m.name}</h3>
              <p class="text-sm text-pf-slate leading-relaxed mb-3">{m.desc}</p>
              {m.href && <a href={m.href} class="text-pf-orange font-bold text-sm">Learn more →</a>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <Wave from="#FFFFFF" to="#FFF6E8" />

  <!-- PROCESS + PRICING (real) -->
  <section class="bg-pf-orange-light py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4 grid md:grid-cols-2 gap-12 items-start">
      <div>
        <p class="text-pf-orange text-sm font-extrabold uppercase tracking-widest mb-2">The process & pricing</p>
        <h2 class="text-3xl md:text-4xl mb-5">Transparent pricing. A structured path forward.</h2>
        <p class="text-pf-slate leading-relaxed mb-4">Your recovery starts with a comprehensive 1-hour assessment. We look at your general skeletal alignment to clear any referred symptoms, and use real-time ultrasound (and an internal exam, only with your consent) to see exactly how your muscles are activating, check for scar tissue, and identify painful zones.</p>
        <p class="text-pf-slate leading-relaxed">You'll leave with a clear treatment plan, a take-home guide, and, if it's helpful, a 5-minute trial on the PelviPower chair to see how it feels.</p>
      </div>
      <div class="bg-white rounded-3xl p-8 border border-orange-100">
        <h3 class="text-xl mb-5">PelviPower pricing</h3>
        <ul class="space-y-4">
          <li class="flex justify-between gap-4 border-b border-orange-100 pb-3"><span class="text-pf-slate">Initial assessment (30 min) + 30 min chair trial</span><span class="font-extrabold text-pf-navy shrink-0">$399</span></li>
          <li class="flex justify-between gap-4 border-b border-orange-100 pb-3"><span class="text-pf-slate">Single PelviPower session</span><span class="font-extrabold text-pf-navy shrink-0">$350</span></li>
          <li class="flex justify-between gap-4"><span class="text-pf-slate">Treatment course (12 sessions)</span><span class="font-extrabold text-pf-navy shrink-0">$1,800</span></li>
        </ul>
        <a href={SITE.bookUrl} class="btn-accent w-full mt-6">Book your assessment</a>
        <p class="text-xs text-slate-500 mt-3 text-center">Located in Ponsonby, welcoming patients from across Auckland.</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4">
      <div class="text-center mb-10"><p class="text-pf-orange text-sm font-extrabold uppercase tracking-widest mb-2">FAQs</p><h2 class="text-3xl md:text-4xl">Common questions</h2></div>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="bg-pf-orange-light rounded-2xl border border-orange-100 group">
            <summary class="cursor-pointer px-6 py-5 font-bold text-pf-ink list-none flex justify-between items-center gap-4"><span>{f.q}</span><span class="text-pf-orange group-open:rotate-45 transition-transform text-3xl font-light leading-none shrink-0">+</span></summary>
            <div class="px-6 pb-6 text-pf-slate leading-relaxed">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ContactForm sourcePage="homepage" />
  <FinalCTA />
</Layout>
