---
import Layout from '../layouts/Layout.astro';
import Wave from '../components/Wave.astro';
import ContactForm from '../components/ContactForm.astro';
import FinalCTA from '../components/FinalCTA.astro';
import { SITE } from '../lib/site';
import { PF_SERVICES } from '../lib/services-data';

const title = 'PelvicForm | Pelvic Health Physio in Ponsonby Auckland | Women, Men & Children';
const description = 'PelvicForm is a dedicated pelvic health physiotherapy clinic in Ponsonby, for women, men and children. Help with incontinence, prolapse, pelvic pain, pregnancy and post-surgery recovery. No referral needed.';
const canonical = `${SITE.domain}/`;
const keywords = 'pelvic health auckland, pelvic floor physio ponsonby, incontinence treatment, prolapse physio, mens pelvic health, womens pelvic health, pelvic pain auckland';

const services = Object.values(PF_SERVICES);
const faqs = [
  { q: 'Do I need a referral?', a: 'No. You can book directly. If a specialist referral would help, we can arrange one.' },
  { q: 'Is this only for women?', a: 'No. We treat women, men and children. Men come to us for prostate recovery, leaking and pelvic pain; children for bedwetting and continence.' },
  { q: 'Is it covered by ACC?', a: 'Often yes, including birth injuries and sensitive claims. Give us a call and we will tell you what is funded.' },
  { q: 'What happens at the first visit?', a: 'A confidential conversation, a careful assessment, and a plan you are comfortable with. You control every step, including whether an internal examination is part of it.' },
];
const schemaJson = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<Layout title={title} description={description} canonical={canonical} keywords={keywords} schemaJson={schemaJson}>
  <section class="relative overflow-hidden bg-pf-ink">
    <div class="absolute inset-0 opacity-40" style="background: radial-gradient(60% 80% at 18% 0%, #1F7A6E 0%, transparent 60%), radial-gradient(50% 70% at 100% 100%, #E8826B 0%, transparent 55%);"></div>
    <div class="relative max-w-5xl mx-auto px-4 py-20 md:py-28 text-center">
      <p class="text-pf-coral text-sm font-extrabold uppercase tracking-widest mb-4">Ponsonby · Women, men & children · No referral needed</p>
      <h1 class="text-4xl md:text-6xl font-black text-white leading-[1.05] mb-6 max-w-3xl mx-auto">Pelvic health is nothing to be embarrassed about</h1>
      <p class="text-lg md:text-xl text-white/85 mb-8 leading-relaxed max-w-2xl mx-auto">Leaking, prolapse, pelvic pain, recovery after birth or surgery. These are common, and they are treatable. PelvicForm is a dedicated pelvic health clinic in Ponsonby, for women, men and children, with care that is expert and completely confidential.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={SITE.bookUrl} class="btn-primary">Book a confidential appointment</a>
        <a href="tel:+6498864611" class="btn-ghost">Or call 09 886 4611</a>
      </div>
    </div>
  </section>

  <Wave from="#1C2B29" to="#FFFFFF" />

  <!-- WHO -->
  <section class="bg-white py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <p class="text-pf-coral text-sm font-extrabold uppercase tracking-widest mb-2">Who we help</p>
        <h2 class="text-3xl md:text-4xl mb-3">Pelvic health affects everyone</h2>
        <p class="text-lg text-pf-slate">It is not just a women's issue. We treat women, men and children, and the conversation is always confidential.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        <div class="bg-pf-teal-light rounded-2xl p-7 border border-teal-100">
          <h3 class="text-xl mb-3 text-pf-teal">Women</h3>
          <p class="text-pf-slate leading-relaxed text-sm">Incontinence, prolapse, pelvic pain, painful sex, and recovery after birth or gynaecological surgery.</p>
        </div>
        <div class="bg-pf-teal-light rounded-2xl p-7 border border-teal-100">
          <h3 class="text-xl mb-3 text-pf-teal">Men</h3>
          <p class="text-pf-slate leading-relaxed text-sm">Prostate surgery recovery, leaking, pelvic pain, and pelvic-floor causes of erectile dysfunction.</p>
        </div>
        <div class="bg-pf-teal-light rounded-2xl p-7 border border-teal-100">
          <h3 class="text-xl mb-3 text-pf-teal">Children</h3>
          <p class="text-pf-slate leading-relaxed text-sm">Bedwetting and daytime continence, with a gentle, child-appropriate approach.</p>
        </div>
      </div>
    </div>
  </section>

  <Wave from="#FFFFFF" to="#E8F4F1" />

  <!-- SERVICES -->
  <section class="bg-pf-teal-light py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <p class="text-pf-coral text-sm font-extrabold uppercase tracking-widest mb-2">How we help</p>
        <h2 class="text-3xl md:text-4xl">What we treat</h2>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
        {services.map((s) => (
          <a href={`/${s.slug}`} class="group bg-white rounded-2xl p-6 border border-teal-100 hover:border-pf-teal hover:shadow-lg transition-all">
            <h3 class="text-lg mb-2 group-hover:text-pf-teal transition-colors">{s.label}</h3>
            <p class="text-sm text-pf-slate leading-relaxed mb-4">{s.intro.slice(0, 110)}...</p>
            <span class="text-pf-teal font-extrabold text-sm">Learn more →</span>
          </a>
        ))}
        <a href="/post-surgical-rehab" class="group bg-white rounded-2xl p-6 border border-teal-100 hover:border-pf-teal hover:shadow-lg transition-all">
          <h3 class="text-lg mb-2 group-hover:text-pf-teal transition-colors">Post-Surgical Rehab</h3>
          <p class="text-sm text-pf-slate leading-relaxed mb-4">Preparing for and recovering from pelvic surgery, for better outcomes...</p>
          <span class="text-pf-teal font-extrabold text-sm">Learn more →</span>
        </a>
      </div>
    </div>
  </section>

  <Wave from="#E8F4F1" to="#FFFFFF" />

  <!-- REASSURANCE -->
  <section class="bg-white py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <p class="text-pf-coral text-sm font-extrabold uppercase tracking-widest mb-2">What it is like</p>
      <h2 class="text-3xl md:text-4xl mb-6">Gentle, expert, and on your terms</h2>
      <p class="text-lg text-pf-slate leading-relaxed mb-4">Your first visit is a confidential conversation and a careful assessment. We explain everything, and you decide what you are comfortable with at every step.</p>
      <p class="text-lg text-pf-slate leading-relaxed">PelvicForm is part of <a href={SITE.rtfUrl} class="text-pf-teal font-semibold underline">Return To Form</a>, our Ponsonby physio clinic, so the wider team is right there if you need them.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white pb-16 md:pb-20">
    <div class="max-w-3xl mx-auto px-4">
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="bg-pf-teal-light rounded-2xl border border-teal-100 group">
            <summary class="cursor-pointer px-6 py-5 font-bold text-pf-ink list-none flex justify-between items-center gap-4"><span>{f.q}</span><span class="text-pf-coral group-open:rotate-45 transition-transform text-3xl font-light leading-none shrink-0">+</span></summary>
            <div class="px-6 pb-6 text-pf-slate leading-relaxed">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <ContactForm sourcePage="homepage" />
  <FinalCTA />
</Layout>
