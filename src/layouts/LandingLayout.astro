---
// Stripped layout for paid-traffic landing pages: NO nav, one CTA goal, noindex, minimal footer.
import '../styles/global.css';
import { SITE } from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonical: string;
}
const { title, description, canonical } = Astro.props;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  name: SITE.name,
  url: SITE.domain,
  image: SITE.logo,
  telephone: '+64-9-886-4611',
  medicalSpecialty: 'Physiotherapy',
};
---
<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE.logo} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Open+Sans:wght@400;500;600;700&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body class="bg-white antialiased">
    <header class="bg-white border-b border-slate-100">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <img src={SITE.logo} alt={SITE.name} class="h-9 md:h-10 w-auto" />
        <a href={SITE.bookUrl} class="btn-primary !py-2 !px-4 text-sm">Book an assessment</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="bg-pf-navy text-blue-100 text-xs">
      <div class="max-w-5xl mx-auto px-4 py-6 flex flex-col sm:flex-row gap-2 justify-between">
        <span>© {SITE.name} · Ponsonby, Auckland</span>
        <a href={`tel:+6498864611`} class="hover:text-pf-orange">{SITE.phone}</a>
      </div>
    </footer>
  </body>
</html>
