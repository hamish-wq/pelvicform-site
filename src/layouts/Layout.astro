---
import '../styles/global.css';
import { SITE, NAV, isActive } from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonical: string;
  keywords?: string;
  schemaJson?: object | object[];
}
const { title, description, canonical, keywords, schemaJson } = Astro.props;
const path = Astro.url.pathname;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  '@id': `${SITE.domain}/#org`,
  name: 'PelvicForm',
  url: SITE.domain,
  logo: SITE.logo,
  telephone: '+64-9-886-4611',
  address: { '@type': 'PostalAddress', streetAddress: '179A Ponsonby Road', addressLocality: 'Ponsonby', addressRegion: 'Auckland', postalCode: '1011', addressCountry: 'NZ' },
  medicalSpecialty: 'Physiotherapy',
  description: 'Specialist pelvic floor physiotherapy in Ponsonby, Auckland, for men and women. Discreet treatment for incontinence, prostate recovery, pelvic pain, Clinical Pilates and PelviPower. Part of Return To Form.',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={SITE.logo} />
    <meta property="og:site_name" content="PelvicForm" />
    <link rel="icon" type="image/png" href="https://assets.cdn.filesafe.space/AiNs33SgZZAvOuPlmM6x/media/69c0895889294eaa5a5ed686.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Open+Sans:wght@400;500;600;700&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {schemaJson && <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />}
  </head>
  <body class="bg-white antialiased">
    <header class="bg-white/95 backdrop-blur border-b border-slate-100 sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center shrink-0" aria-label="PelvicForm home">
          <img src={SITE.logo} alt="PelvicForm" class="h-9 md:h-10 w-auto" />
        </a>
        <nav class="hidden lg:flex items-center gap-6 text-sm font-bold">
          {NAV.map((item) => (
            <a href={item.href} class:list={['transition-colors', isActive(path, item.href) ? 'text-pf-orange' : 'text-pf-ink hover:text-pf-orange']}>{item.label}</a>
          ))}
        </nav>
        <a href={SITE.bookUrl} class="btn-accent !py-2.5 !px-5 text-sm shrink-0">Book your assessment</a>
      </div>
    </header>
    <main><slot /></main>
    <footer class="bg-pf-navy text-blue-100 mt-24">
      <div class="max-w-6xl mx-auto px-4 py-12 grid md:grid-cols-3 gap-8 text-sm">
        <div>
          <img src={SITE.logo} alt="PelvicForm" class="h-9 w-auto mb-4 brightness-0 invert" />
          <p class="leading-relaxed text-blue-200">Specialist pelvic floor physiotherapy in Ponsonby, for men and women. Discreet, expert care. Part of Return To Form.</p>
          <p class="mt-3"><a href="tel:+6498864611" class="hover:text-pf-orange font-semibold">09 886 4611</a></p>
        </div>
        <div>
          <p class="font-bold text-white mb-3 uppercase tracking-wide text-xs">Pelvic health</p>
          <ul class="space-y-2">
            <li><a href="/womens-pelvic-health" class="hover:text-pf-orange">Women's Pelvic Health</a></li>
            <li><a href="/mens-pelvic-health" class="hover:text-pf-orange">Men's Pelvic Health</a></li>
            <li><a href="/pelvipower-therapy" class="hover:text-pf-orange">PelviPower Therapy</a></li>
            <li><a href="/clinical-pilates" class="hover:text-pf-orange">Clinical Pilates</a></li>
          </ul>
        </div>
        <div>
          <p class="font-bold text-white mb-3 uppercase tracking-wide text-xs">Clinic</p>
          <ul class="space-y-2">
            <li><a href="/about" class="hover:text-pf-orange">About</a></li>
            <li><a href="/contact" class="hover:text-pf-orange">Contact</a></li>
            <li>179A Ponsonby Road, Auckland</li>
            <li><a href={SITE.rtfUrl} class="hover:text-pf-orange">Return To Form (general physio)</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10"><div class="max-w-6xl mx-auto px-4 py-5 text-xs text-blue-300">© PelvicForm · Part of Return To Form · 179A Ponsonby Road, Ponsonby, Auckland</div></div>
    </footer>
  </body>
</html>
