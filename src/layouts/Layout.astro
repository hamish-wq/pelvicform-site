---
import '../styles/global.css';
import { SITE, NAV, isActive } from '../lib/site';

interface Props {
  title: string;
  description: string;
  canonical: string;
  keywords?: string;
  schemaJson?: object | object[];
}
const { title, description, canonical, keywords, schemaJson } = Astro.props;
const path = Astro.url.pathname;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  '@id': `${SITE.domain}/#org`,
  name: 'PelvicForm',
  url: SITE.domain,
  telephone: '+64-9-886-4611',
  address: { '@type': 'PostalAddress', streetAddress: '179A Ponsonby Road', addressLocality: 'Ponsonby', addressRegion: 'Auckland', postalCode: '1011', addressCountry: 'NZ' },
  medicalSpecialty: 'Physiotherapy',
  description: 'Pelvic health physiotherapy in Ponsonby, Auckland, for women, men and children. Part of Return To Form.',
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="PelvicForm" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@400;600;700;800;900&display=swap" />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {schemaJson && <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />}
  </head>
  <body class="bg-white antialiased">
    <header class="bg-white/95 backdrop-blur border-b border-slate-100 sticky top-0 z-50">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2 shrink-0" aria-label="PelvicForm home">
          <span class="w-8 h-8 rounded-full bg-pf-teal text-white flex items-center justify-center font-black">P</span>
          <span class="font-black text-lg text-pf-ink tracking-tight">PelvicForm</span>
        </a>
        <nav class="hidden lg:flex items-center gap-6 text-sm font-bold">
          {NAV.map((item) => (
            <a href={item.href} class:list={['transition-colors', isActive(path, item.href) ? 'text-pf-teal' : 'text-pf-ink hover:text-pf-teal']}>{item.label}</a>
          ))}
        </nav>
        <a href={SITE.bookUrl} class="btn-primary !py-2.5 !px-5 text-sm shrink-0">Book now</a>
      </div>
    </header>
    <main><slot /></main>
    <footer class="bg-pf-ink text-slate-300 mt-24">
      <div class="max-w-6xl mx-auto px-4 py-12 grid md:grid-cols-3 gap-8 text-sm">
        <div>
          <p class="font-black text-white text-lg mb-3">PelvicForm</p>
          <p class="leading-relaxed text-slate-400">Pelvic health physiotherapy in Ponsonby, for women, men and children. Part of Return To Form.</p>
          <p class="mt-3"><a href="tel:+6498864611" class="hover:text-pf-coral font-semibold">09 886 4611</a></p>
        </div>
        <div>
          <p class="font-bold text-white mb-3 uppercase tracking-wide text-xs">Pelvic health</p>
          <ul class="space-y-2">
            <li><a href="/womens-pelvic-health" class="hover:text-pf-coral">Women's Health</a></li>
            <li><a href="/mens-pelvic-health" class="hover:text-pf-coral">Men's Health</a></li>
            <li><a href="/pregnancy-postnatal" class="hover:text-pf-coral">Pregnancy & Postnatal</a></li>
            <li><a href="/post-surgical-rehab" class="hover:text-pf-coral">Post-Surgical Rehab</a></li>
            <li><a href="/pelvic-pain" class="hover:text-pf-coral">Pelvic Pain</a></li>
          </ul>
        </div>
        <div>
          <p class="font-bold text-white mb-3 uppercase tracking-wide text-xs">Clinic</p>
          <ul class="space-y-2">
            <li><a href="/about" class="hover:text-pf-coral">About</a></li>
            <li><a href="/contact" class="hover:text-pf-coral">Contact</a></li>
            <li><a href={SITE.rtfUrl} class="hover:text-pf-coral">Return To Form (general physio)</a></li>
          </ul>
        </div>
      </div>
      <div class="border-t border-white/10"><div class="max-w-6xl mx-auto px-4 py-5 text-xs text-slate-500">© PelvicForm · Part of Return To Form · 179A Ponsonby Road, Auckland</div></div>
    </footer>
  </body>
</html>
